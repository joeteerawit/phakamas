{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npx -y pnpm@12.16.1 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@12.16.1 run build",
  "outputDirectory": "dist"
}
